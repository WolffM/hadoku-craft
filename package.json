{
  "name": "@wolffm/hadoku-craft",
  "version": "2.1.2",
  "description": "Print-prep and color-palette toolkit: crop, resize, collate images for print, and extract palettes from images",
  "type": "module",
  "packageManager": "pnpm@11.5.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WolffM/hadoku-craft.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/entry.d.ts",
      "default": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./api": {
      "types": "./dist/worker/index.d.ts",
      "default": "./dist/worker.js"
    }
  },
  "scripts": {
    "dev": "pm2 start ecosystem.config.cjs --silent && vite",
    "build": "vite build && vite build --config worker/vite.config.ts && tsc -p tsconfig.build.json && tsc -p tsconfig.worker-types.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:css": "stylelint \"src/**/*.css\" && node node_modules/@wolffm/themes/scripts/check-usage.mjs ./src",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "prepare": "git config core.hooksPath .husky 2>/dev/null || true",
    "local:start": "pm2 start ecosystem.config.cjs",
    "local:stop": "pm2 stop craft-server",
    "local:restart": "pm2 restart craft-server",
    "local:logs": "pm2 logs craft-server",
    "local:status": "pm2 status"
  },
  "peerDependencies": {
    "@wolffm/logger": ">=1.3.2",
    "@wolffm/task-ui-components": ">=4.7.3",
    "@wolffm/themes": ">=5.7.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.1.5",
    "@wolffm/logger": "^1.4.1",
    "@wolffm/prefs-client": "^1.0.12",
    "hono": "^4.11.4",
    "pica": "^9.0.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251230.0",
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@typescript-eslint/eslint-plugin": "^8.46.4",
    "@typescript-eslint/parser": "^8.46.4",
    "@vitejs/plugin-react": "^5.1.0",
    "@vitest/coverage-v8": "^4.1.7",
    "@wolffm/catalogue": "^1.0.1",
    "@wolffm/task-ui-components": "^4.8.3",
    "@wolffm/themes": "^5.8.5",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^14.0.0",
    "happy-dom": "^20.9.0",
    "prettier": "^3.6.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "stylelint": "^17.12.0",
    "stylelint-value-no-unknown-custom-properties": "^6.1.1",
    "typescript": "^5.6.3",
    "vite": "^7.1.12",
    "vitest": "^4.1.7"
  }
}
